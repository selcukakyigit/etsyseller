# Etsy Developer App (https://www.etsy.com/developers/your-apps)
# Not: ETSY_SHOP_ID artık gerekmiyor — mağaza, kullanıcı Etsy'ye bağlandığında
# otomatik olarak keşfedilip veritabanına kaydediliyor (bkz. app/shops).
ETSY_API_KEY=
ETSY_SHARED_SECRET=
# Etsy allows plain HTTP only for loopback hosts (literally "localhost" or
# 127.0.0.1) — any other hostname (even one that resolves to 127.0.0.1, like
# localtest.me) is treated as "real" and must be HTTPS. So: literal localhost.
ETSY_REDIRECT_URI=http://localhost:8000/api/shops/connect/callback

# OpenAI API key for SEO generation. OPENAI_MODEL'i hesabında erişimin olan
# en güncel GPT modeliyle değiştir (ör. daha yeni bir sürüm çıktıysa).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic (Claude) — alternative SEO generation provider, set AI_PROVIDER to
# "anthropic" to use it instead of OpenAI. Manage all of this from /settings.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
AI_PROVIDER=openai

# Google AI Studio (Gemini) — yalnızca listing fotoğraflarını "sihirli değnek" ile
# yeniden oluşturmak ("nano banana" görsel modeli) için kullanılır.
GOOGLE_API_KEY=
# Varsayılan: gemini-3.1-flash-image-preview. gemini-2.5-flash-image Gemini API'de
# 2 Ekim 2026'da emekliye ayrılıyor, o yüzden yeni kurulumlar bunu kullanmamalı.
# GOOGLE_IMAGE_MODEL=gemini-3.1-flash-image-preview
# GOOGLE_IMAGE_SIZE=2K   # 1K | 2K | 4K — yükseldikçe fiyat da artar

# Frontend origin allowed for CORS + post-login redirect target
FRONTEND_URL=http://localhost:3000

# SQLite by default; override for Postgres etc.
DATABASE_URL=sqlite:///./data.db

# Uygulama kendi kullanıcı adı/şifre login sistemine sahip (Etsy hesabından
# bağımsız). Oturum httpOnly bir cookie'de tutulur (varsayılan 90 gün).

# Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
# Postgres bağlantısı (Supabase > Connect > Session pooler)
DATABASE_URL=

# Etsy belirteç şifreleme (Fernet anahtarı)
TOKEN_ENCRYPTION_KEY=
